# Copy to .env and adjust if needed. Every value below is the default.

# --- Database ---------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=sheepcounter

# Set to 1 to run without MongoDB, on an in-memory fake database (mongomock).
# Useful for a quick demo; all data is lost when the process stops.
USE_MOCK_DB=0

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=10

# --- Sleep-stage model ------------------------------------------------------
# Where the trained model is stored, and how many synthetic nights to train on.
MODEL_DIR=app/model_store
TRAIN_NIGHTS=60
